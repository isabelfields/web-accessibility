{
  "name": "hearst-a11y",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test tests/*.test.mjs",
    "generate-jackson-certs": "node -e \"const {execSync}=require('child_process');const k=execSync('openssl genrsa 2048 2>/dev/null').toString();const pk=execSync('openssl pkcs8 -topk8 -nocrypt',{input:k}).toString();const pub=execSync('openssl rsa -pubout 2>/dev/null',{input:k}).toString();console.log('JACKSON_PRIVATE_KEY=\\\"'+pk.replace(/\\n/g,'\\\\n')+'\\\",\\nJACKSON_PUBLIC_KEY=\\\"'+pub.replace(/\\n/g,'\\\\n')+'\\\"');\""
  },
  "dependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@neondatabase/serverless": "^0.9.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "@types/bcryptjs": "^2.4.6",
    "axe-core": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.30.0",
    "next": "15.3.9",
    "next-auth": "^4.24.0",
    "openai": "^4.67.0",
    "pa11y": "^8.0.0",
    "playwright": "^1.44.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.8.1",
    "@boxyhq/saml-jackson": "^1.52.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.21.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.3.9",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}

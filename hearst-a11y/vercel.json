{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "src/app/api/scan/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/auth/**": {
      "includeFiles": "node_modules/jose/**"
    },
    "src/app/api/admin/saml/**": {
      "includeFiles": "node_modules/jose/**"
    }
  }
}

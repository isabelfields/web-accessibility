# ─────────────────────────────────────────────────────────────
# Hearst Accessibility Scanner — environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon serverless Postgres) ──────────────────────
# Connection string from your Neon project dashboard.
# Used by the Neon serverless client; apply the schema via POST /api/migrate.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ── Authentication (NextAuth credentials provider) ───────────
# The single admin login. Sign in at /login with these values.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to sign NextAuth JWT session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-byte-secret"

# Secret protecting the PDF export endpoint (/api/scans/[id]/export).
ADMIN_SECRET="generate-a-random-secret"

# ── AI fix suggestions (OpenAI, gpt-4o) ──────────────────────
# API key used to generate fix suggestions for violations that
# don't have a hardcoded fix in known-fixes.ts.
OPENAI_API_KEY="sk-..."

# ── Headless browser (Browserless.io) ────────────────────────
# Token for the remote Chrome instance used to render and scan pages.
BROWSERLESS_TOKEN="your-browserless-token"

# ── Scheduled scans (Vercel Cron) ────────────────────────────
# Shared secret the cron route (/api/cron) checks before running
# due schedules. Vercel sends this as a Bearer token.
CRON_SECRET="generate-a-random-secret"

# Absolute base URL of the deployed app (e.g. https://a11y.hearst.com).
# Optional — the cron job runs scans in-process, so this is only used for
# building absolute links if needed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Jira integration ─────────────────────────────────────────
# Optional. Enables "Create Jira ticket" on violation cards.
# Uses Atlassian OAuth 2.0 (3LO), so every app user connects their own Jira
# account and tickets are created with that user's Jira permissions.
JIRA_CLIENT_ID="atlassian-oauth-client-id"
JIRA_CLIENT_SECRET="atlassian-oauth-client-secret"
JIRA_REDIRECT_URI="http://localhost:3000/api/integrations/jira/oauth/callback"
# Optional: force a specific Jira site when users can access more than one.
JIRA_CLOUD_ID=""
JIRA_BASE_URL="https://your-domain.atlassian.net"
# Optional default. Users can override this per ticket in the violation card.
JIRA_PROJECT_KEY=""
JIRA_ISSUE_TYPE="Bug"

# ── SAML / SSO (BoxyHQ Jackson) ──────────────────────────────
# URL of this app — used as the SAML audience and for Jackson's OAuth endpoints.
NEXTAUTH_URL="http://localhost:3000"

# Shared secret between NextAuth and Jackson for the OAuth token exchange.
# Generate with: openssl rand -base64 32
JACKSON_CLIENT_SECRET="generate-a-random-secret"

# Optional: separate Postgres URL for Jackson's internal tables.
# Defaults to DATABASE_URL if not set.
# JACKSON_DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# RSA key pair for Jackson token signing — REQUIRED on Node 18+/OpenSSL 3.x.
# Without these, Jackson auto-generates keys but stores them in legacy PKCS#1 format
# which OpenSSL 3.x rejects with ERR_OSSL_UNSUPPORTED.
#
# Generate with:
#   openssl genrsa -out jackson.key 2048
#   openssl pkcs8 -topk8 -nocrypt -in jackson.key -out jackson.key.pkcs8
#   openssl rsa -in jackson.key -pubout -out jackson.pub
# Then set the vars by replacing newlines with \n:
#   JACKSON_PRIVATE_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' jackson.key.pkcs8)"
#   JACKSON_PUBLIC_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' jackson.pub)"
JACKSON_PRIVATE_KEY=""
JACKSON_PUBLIC_KEY=""
